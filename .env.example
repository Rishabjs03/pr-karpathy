# lucidiff configuration. Copy to .env (lucidiff reads it from the current directory) or
# export these variables in your shell. Variables already set in the environment win.

# --- LLM provider: set at least one --------------------------------------------------------
# lucidiff picks the first provider with a key, in this order, unless LUCIDIFF_PROVIDER is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Vercel AI Gateway: one key for many providers. Model ids look like "anthropic/claude-opus-5-5".
AI_GATEWAY_API_KEY=

# --- Defaults for --provider and --model (optional) ---------------------------------------
# LUCIDIFF_PROVIDER=anthropic        # anthropic | openai | gateway
# LUCIDIFF_MODEL=claude-opus-5-5     # defaults: claude-opus-5-5, gpt-5.5, anthropic/claude-opus-5-5

# --- Custom endpoints (optional) -----------------------------------------------------------
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- GitHub (optional) ---------------------------------------------------------------------
# Needed for private repositories, and raises the API rate limit from 60 to 5,000 requests/hour.
# A fine-grained token with read access to "Contents" and "Pull requests" is enough.
GITHUB_TOKEN=
# For GitHub Enterprise Server. Defaults to https://api.github.com, or https://<host>/api/v3
# when the PR URL is not on github.com.
# GITHUB_API_URL=https://github.example.com/api/v3

# --- Output (optional) ---------------------------------------------------------------------
# Set to 1 to disable spinners and colors (useful in CI logs).
# LUCIDIFF_PLAIN_OUTPUT=1
