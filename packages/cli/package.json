{
  "name": "lucidiff",
  "version": "0.1.0",
  "description": "Turn a pull request into a self-contained, interactive HTML explainer.",
  "keywords": [
    "pull-request",
    "code-review",
    "cli",
    "llm",
    "explainer"
  ],
  "license": "MIT",
  "author": "Rishab Agarwal",
  "homepage": "https://github.com/Rishabjs03/pr-karpathy#readme",
  "bugs": {
    "url": "https://github.com/Rishabjs03/pr-karpathy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rishabjs03/pr-karpathy.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "exports": {
    ".": {
      "@lucidiff/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "lucidiff": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lucidiff/core": "workspace:*",
    "@lucidiff/renderer": "workspace:*",
    "ai": "^7.0.127",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  }
}
