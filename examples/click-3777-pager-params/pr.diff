+class _FakePagerProcess:
+    """Stand-in for :class:`subprocess.Popen` recording argv and env without
+    launching a process."""
+
+    def __init__(self, argv, *, env=None, **kwargs):
+        self.argv = argv
+        self.env = env
+        self.returncode = 0
+        self.stdin = io.StringIO()
+
+    def terminate(self):
+        pass
+
+    def wait(self):
+        return 0
+
+
