+    monkeypatch.setattr(click._termui_impl, "WIN", True)
+    monkeypatch.delitem(click._termui_impl.os.environ, "LESS", raising=False)
+
+    with click._termui_impl._pipepager(fake_pager, []) as (_, color):
+        assert color is True
