{
  "name": "lucidiff-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Turn a pull request into a self-contained, interactive HTML explainer.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "sample": "pnpm --filter @lucidiff/core --filter @lucidiff/renderer build && node scripts/render-sample.mjs",
    "examples": "node --experimental-strip-types scripts/generate-examples.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@lucidiff/core": "workspace:*",
    "@lucidiff/renderer": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lucidiff": "workspace:*",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
